---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { currentWork, journey, profile } from '@/data/profile';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 4);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: 'https://sunilsadasivan.com',
  image: 'https://sunilsadasivan.com/images/sunil.png',
  jobTitle: 'Vice President of Engineering',
  worksFor: { '@type': 'Organization', name: 'NGP VAN', url: 'https://www.ngpvan.com/' },
  founder: { '@type': 'Organization', name: 'Pingdex', url: 'https://pingdex.app/' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Michigan' },
  sameAs: Object.values(profile.social),
};
---

<BaseLayout jsonLd={personSchema}>
  <section class="hero shell">
    <div class="hero-copy">
      <div class="availability" data-reveal>
        <span></span>
        Washington, D.C. · Building what comes next
      </div>
      <h1 data-reveal>
        Technology <br class="mobile-only" />for<br />
        <em>people who <br class="mobile-only" />move</em><br />
        the world <br class="mobile-only" />forward.
      </h1>
      <p class="hero-lede" data-reveal>
        I’m Sunil—an engineer, founder, and civic technologist. I lead engineering at
        <a href="https://www.ngpvan.com/">NGP VAN</a> and founded
        <a href="https://pingdex.app/">Pingdex</a>.
      </p>
      <div class="hero-actions" data-reveal>
        <a class="button primary" href="#work">Explore my work <span>↓</span></a>
        <a class="button ghost" href="/blog/">Read my writing <span>↗</span></a>
      </div>
    </div>
    <div class="hero-visual" data-reveal>
      <div class="portrait-wrap">
        <div class="orbit orbit-one"><span>build</span></div>
        <div class="orbit orbit-two"><span>lead</span></div>
        <div class="portrait-glow"></div>
        <img class="portrait" src="/images/sunil.png" alt="Sunil Sadasivan" width="520" height="520" />
        <div class="portrait-caption">
          <span class="caption-mark">SS</span>
          <span>Engineer<br />Founder<br />Optimist</span>
        </div>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span></span>Scroll to explore</div>
  </section>

  <section id="work" class="section shell">
    <div class="section-heading" data-reveal>
      <p class="kicker">What I’m building</p>
      <h2>Software is a lever.<br /><em>Impact is the point.</em></h2>
    </div>
    <div class="work-grid">
      {currentWork.map((item, index) => (
        <article class={`work-card ${item.accent}`} data-reveal>
          <div class="work-number">0{index + 1}</div>
          <div>
            <p class="work-eyebrow">{item.eyebrow}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <a href={item.href}>{item.link} <span>↗</span></a>
          </div>
          <div class="card-orb" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </section>

  <section id="about" class="section about-section">
    <div class="shell about-grid">
      <div class="about-sticky" data-reveal>
        <p class="kicker">A career in chapters</p>
        <h2>Building systems.<br />Growing teams.<br /><em>Following impact.</em></h2>
        <p>
          My path runs from consumer startups to federal services to political campaigns. The thread is
          constant: find consequential problems, build with care, and help good people do their best work.
        </p>
      </div>
      <ol class="journey-list">
        {journey.map((item, index) => (
          <li data-reveal>
            <div class="journey-index">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <p>{item.when}</p>
              <h3>{item.title}</h3>
              <span>{item.body}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="belief-strip" aria-label="Working philosophy">
    <div>
      <span>Stay curious</span><i>✦</i><span>Build the team</span><i>✦</i><span>Ship useful things</span><i>✦</i>
      <span>Stay curious</span><i>✦</i><span>Build the team</span><i>✦</i><span>Ship useful things</span><i>✦</i>
    </div>
  </section>

  <section class="section shell writing-section">
    <div class="section-heading split" data-reveal>
      <div>
        <p class="kicker">From the archive</p>
        <h2>Notes on building,<br /><em>leading, and learning.</em></h2>
      </div>
      <a class="text-link" href="/blog/">View all 13 essays <span>↗</span></a>
    </div>
    <div class="posts-grid">
      {posts.map((post, index) => <PostCard post={post} featured={index === 0} />)}
    </div>
  </section>

  <section class="contact-section shell" data-reveal>
    <div class="contact-orb" aria-hidden="true"></div>
    <p class="kicker">Let’s build something useful</p>
    <h2>Good ideas get better<br /><em>in conversation.</em></h2>
    <a class="button light" href={`mailto:${profile.email}`}>Start a conversation <span>↗</span></a>
  </section>
</BaseLayout>
